{
  "analysis_name": "Australia-New Zealand student visa decision comparison",
  "period": "2022-2025",
  "years": [2022, 2023, 2024, 2025],
  "destinations": {
    "AU": {
      "name": "Australia",
      "pooled_file": "data/prepared/australia/student_visa_decisions_2022-2025-m49.csv",
      "annual_pattern": "data/prepared/australia/student_visa_decisions_{year}-m49.csv"
    },
    "NZ": {
      "name": "New Zealand",
      "pooled_file": "data/prepared/new-zealand/student_visa_decisions_2022-2025-m49.csv",
      "annual_pattern": "data/prepared/new-zealand/student_visa_decisions_{year}-m49.csv"
    }
  },
  "reference_destination": "NZ",
  "comparison_destination": "AU",
  "rate_difference_direction": "AU - NZ",
  "confidence_level": 0.95,
  "small_denominator_thresholds": [20, 50],
  "sensitivity_denominator_thresholds": [0, 20, 50, 100],
  "fdr_level": 0.05,
  "minimum_expected_count_for_asymptotic_test": 5,
  "forest_plot_max_countries": 20,
  "bootstrap_seed": 20260927,
  "bootstrap_replicates": 10000,
  "article_b_decomposition": {
    "primary_common_weight": "average_destination_shares",
    "weight_schemes": [
      "observed_destination_specific",
      "average_destination_shares",
      "australia_shares",
      "new_zealand_shares",
      "equal_origin"
    ],
    "primary_annual_support": "year_specific_matched",
    "temporal_sensitivity_support": "balanced_four_year_matched",
    "bootstrap_unit": "origin_country"
  },
  "retained_non_m49": {
    "AU": ["Kosovo", "Taiwan"],
    "NZ": ["Taiwan"]
  },
  "excluded_non_country_labels": ["Not Specified", "Refugee"],
  "interpretation_scope": "descriptive and associational; not causal"
}
