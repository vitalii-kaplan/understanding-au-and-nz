data/original/

# Reproducible prepared and intermediate research data.
data/prepared/**/*.csv
data/prepared/**/*.parquet

# Final CSV result tables and manifests are versioned. Keep binary result
# formats local unless a publication workflow explicitly requires them.
data/results/**/*.parquet
data/results/**/*.sqlite

